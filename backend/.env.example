PORT=5000

# Local development: Postgres runs in Docker and is published on host port 5433.
# Keep these in sync with the root .env used by compose.yaml.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=mydb

# Only set if the frontend is served from a different origin than the API.
# CORS_ORIGIN=http://localhost:5173
